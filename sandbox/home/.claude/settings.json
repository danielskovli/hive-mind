{
  "autoMemoryDirectory": "/home/agent/hive/memory",
  "autoDreamEnabled": false,
  "idleCompaction": false,
  "awaySummaryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/agent/hive/hive-mind/bin/hive sync --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/agent/hive/hive-mind/bin/hive guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/agent/hive/hive-mind/bin/hive save --background",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/agent/hive/hive-mind/bin/hive keepalive stop",
            "timeout": 7200,
            "asyncRewake": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/agent/hive/hive-mind/bin/hive keepalive prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/agent/hive/hive-mind/bin/hive save --background",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/agent/hive/hive-mind/bin/hive keepalive end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
